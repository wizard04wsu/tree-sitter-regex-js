{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "regex_js",
      "camelcase": "RegexJS",
      "title": "JavaScript Regular Expressions",
      "scope": "source.regex-js",
      "file-types": [
        "regex_js"
      ],
      "injection-regex": "^regex[_-]js$",
      "class-name": "TreeSitterRegexJs"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar/parser for JavaScript regular expressions",
    "authors": [
      {
        "name": "Andy Harrison",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/wizard04wsu/tree-sitter-regex-js",
      "funding": ""
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
